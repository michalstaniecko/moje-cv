{
  "name": "moje-cv",
  "productName": "CV Drawer",
  "version": "0.6.0",
  "private": true,
  "description": "CV Drawer – generator CV z podglądem stron A4 i eksportem do PDF",
  "author": "Michal Staniecko",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "screenshots": "electron-vite build && playwright test -c screenshots/playwright.config.ts",
    "dist:e2e": "electron-vite build && electron-builder --mac --dir --universal --config electron-builder.e2e.yml",
    "test:e2e:packaged": "pnpm dist:mac && pnpm dist:e2e && MOJE_CV_DIST_APP=\"dist/mac-universal/CV Drawer.app\" MOJE_CV_APP=\"dist-e2e/mac-universal/CV Drawer.app/Contents/MacOS/CV Drawer\" playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
