# Wpis CV Drawer w Mac App Store (#48): metadane z `fastlane/metadata/` i zrzuty ekranu z `pnpm screenshots`
# wysyłane przez App Store Connect API. Instrukcja: docs/wydanie-mac-app-store.md ("Wpis w App Store Connect").
#
#   fastlane mac metadata      # opisy, słowa kluczowe, adresy, kategoria, copyright
#   fastlane mac screenshots   # zrzuty z dist/screenshots/{pl,en}, en do en-GB i en-US (najpierw `pnpm screenshots`)
#
# Wersja w App Store Connect to `version` z package.json; jeśli nie ma jeszcze edytowalnej wersji o tym numerze,
# deliver ją tworzy.

require "json"

ROOT = File.expand_path("..", __dir__)

# Języki zrzutów z screenshots/appStore.spec.ts → lokalizacje App Store Connect (te same co w fastlane/metadata).
# en-GB to język główny wpisu; en-US ma ten sam tekst i zrzuty.
SCREENSHOT_LOCALES = { "pl" => ["pl"], "en" => ["en-GB", "en-US"] }.freeze

default_platform(:mac)

platform :mac do
  # Klucz API App Store Connect z tych samych zmiennych co notaryzacja `.dmg` (electron-builder.yml): `APPLE_API_KEY_ID`,
  # `APPLE_API_ISSUER` i opcjonalnie `APPLE_API_KEY` (ścieżka do .p8; domyślnie
  # ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8, jak dla `xcrun altool`). Klucz potrzebuje roli App Manager.
  private_lane :asc_api_key do
    key_id = ENV["APPLE_API_KEY_ID"].to_s
    issuer_id = ENV["APPLE_API_ISSUER"].to_s
    UI.user_error!("Brak APPLE_API_KEY_ID albo APPLE_API_ISSUER (klucz API App Store Connect).") if key_id.empty? || issuer_id.empty?
    key_path = ENV["APPLE_API_KEY"].to_s
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8") if key_path.empty?
    UI.user_error!("Nie ma pliku klucza #{key_path}.") unless File.exist?(key_path)
    app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path)
  end

  private_lane :app_version do
    JSON.parse(File.read(File.join(ROOT, "package.json"))).fetch("version")
  end

  # Sekcja App Review: notatka z fastlane/app_review_notes.txt i kontakt ze zmiennych `APP_REVIEW_FIRST_NAME`,
  # `APP_REVIEW_LAST_NAME`, `APP_REVIEW_EMAIL`, `APP_REVIEW_PHONE` (np. +48 600 000 000) – dane osobowe, poza repo.
  # App Store Connect przyjmuje zmianę tej sekcji tylko z pełnym kontaktem, więc bez niego jest pomijana.
  private_lane :app_review_information do
    contact = {
      first_name: ENV["APP_REVIEW_FIRST_NAME"].to_s.strip,
      last_name: ENV["APP_REVIEW_LAST_NAME"].to_s.strip,
      email_address: ENV["APP_REVIEW_EMAIL"].to_s.strip,
      phone_number: ENV["APP_REVIEW_PHONE"].to_s.strip
    }
    if contact.values.any?(&:empty?)
      UI.important("Pomijam sekcję App Review: brak APP_REVIEW_FIRST_NAME, APP_REVIEW_LAST_NAME, APP_REVIEW_EMAIL albo APP_REVIEW_PHONE.")
      next nil
    end
    contact.merge(notes: File.read(File.join(ROOT, "fastlane/app_review_notes.txt")).strip)
  end

  desc "Wysyła metadane wpisu (fastlane/metadata) do App Store Connect, bez zrzutów i binarki"
  lane :metadata do
    options = {
      api_key: asc_api_key,
      app_version: app_version,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      skip_screenshots: true
    }
    review = app_review_information
    options[:app_review_information] = review if review
    deliver(**options)
  end

  desc "Zastępuje zrzuty ekranu w App Store Connect zrzutami z dist/screenshots (pnpm screenshots)"
  lane :screenshots do
    source = File.join(ROOT, "dist/screenshots")
    staging = File.join(ROOT, "dist/fastlane-screenshots")
    FileUtils.rm_rf(staging)
    SCREENSHOT_LOCALES.each do |language, locales|
      files = Dir[File.join(source, language, "*.png")].sort
      UI.user_error!("Brak zrzutów w #{File.join(source, language)}. Najpierw `pnpm screenshots`.") if files.empty?
      locales.each do |locale|
        FileUtils.mkdir_p(File.join(staging, locale))
        FileUtils.cp(files, File.join(staging, locale))
      end
    end
    deliver(
      api_key: asc_api_key,
      app_version: app_version,
      screenshots_path: staging,
      skip_metadata: true,
      overwrite_screenshots: true
    )
  end
end
